# Feature switches layered on top of .env.test (credentials live there).
# .env values win over .env.test values for the same key.
REALTIME_PROVIDER=doubao
QWEN_SUBTITLE_ENABLED=true

# 外呼营销场景开关（子系统1：单通对话引擎）
OUTBOUND_ENABLED=true

# 性别交叉音色：男客户听女声、女客户听男声；留空回退 DOUBAO_TTS_SPEAKER
# 女客户听到的男声（yunzhou · 沉稳男声）
OUTBOUND_TTS_SPEAKER_MALE=zh_male_yunzhou_jupiter_bigtts
# 男客户听到的女声（xiaohe · 甜美女声）
OUTBOUND_TTS_SPEAKER_FEMALE=zh_female_xiaohe_jupiter_bigtts
