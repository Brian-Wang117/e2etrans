# Copy this file to .env.test (credentials) and/or .env (feature switches).
# .env is loaded after .env.test and wins on duplicate keys.

# Server
HOST=127.0.0.1
PORT=8765

# Feature switches (put in .env)
REALTIME_PROVIDER=doubao
QWEN_SUBTITLE_ENABLED=true

# Outbound call engine (子系统1：单通对话引擎，put in .env)
OUTBOUND_ENABLED=false
# OUTBOUND_SILENCE_SECONDS=60
# OUTBOUND_MAX_TURNS=50
# OUTBOUND_OPENING_TEXT=
# OUTBOUND_BUSINESS_BACKGROUND=
# OUTBOUND_BOT_NAME=
# OUTBOUND_SPEAKING_STYLE=
# 性别交叉音色：男客户听女声、女客户听男声；留空则回退 DOUBAO_TTS_SPEAKER
# OUTBOUND_TTS_SPEAKER_MALE=
# OUTBOUND_TTS_SPEAKER_FEMALE=

# Doubao realtime dialogue credentials
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_APP_KEY=
DOUBAO_TTS_SPEAKER=
DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime_dialogue
# Optional overrides:
# DOUBAO_MODEL=            (empty = provider default)
# DOUBAO_INPUT_MODE=push_to_talk
# DOUBAO_INPUT_SAMPLE_RATE=16000
# DOUBAO_OUTPUT_SAMPLE_RATE=24000
# DOUBAO_CONNECT_TIMEOUT_SECONDS=15
# WS_ALLOWED_ORIGINS=      (default: derived from HOST/PORT)

# Qwen subtitle translation (bypass only, never blocks audio)
DASHSCOPE_API_KEY=
# QWEN_SUBTITLE_MODEL=
# QWEN_TIMEOUT_SECONDS=
